# NoticeGuard AI - Gemma Environment Configuration

# Provider choice: 'openai-compatible', 'google', 'groq', 'together', or 'openrouter'
GEMMA_PROVIDER=openai-compatible

# -------------------------------------------------------------
# OPTION 1: Google AI Studio (Official Google Gemma API)
# Get key for free at: https://aistudio.google.com/app/apikey
# -------------------------------------------------------------
# GEMMA_API_KEY=your_google_ai_studio_api_key_here
# GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMMA_MODEL=gemini-2.5-flash

# -------------------------------------------------------------
# OPTION 2: Groq Cloud (Free, Extremely fast Gemma-2-9b / Gemma models)
# Get free key in 30 seconds at: https://console.groq.com/keys
# -------------------------------------------------------------
# GEMMA_API_KEY=gsk_your_groq_api_key_here
# GEMMA_BASE_URL=https://api.groq.com/openai/v1
# GEMMA_MODEL=gemma2-9b-it

# -------------------------------------------------------------
# OPTION 3: OpenRouter (Free / Low Cost Gemma models)
# Get key at: https://openrouter.ai/keys
# -------------------------------------------------------------
# GEMMA_API_KEY=sk-or-v1-your_openrouter_key
# GEMMA_BASE_URL=https://openrouter.ai/api/v1
# GEMMA_MODEL=google/gemma-2-9b-it:free

# -------------------------------------------------------------
# OPTION 4: Local Ollama (100% Free & Offline, No API key needed)
# Run: ollama run gemma2
# -------------------------------------------------------------
# GEMMA_API_KEY=ollama
# GEMMA_BASE_URL=http://localhost:11434/v1
# GEMMA_MODEL=gemma2

# Set to true to view raw model outputs in console
DEBUG=false
