# NoticeGuard AI Configuration

# Gemma Model Provider
# Supported examples: 'openai-compatible', 'google', 'groq', 'together', 'ollama'
GEMMA_PROVIDER=openai-compatible

# Your Gemma 4 API Key (Leave empty to enable DEMO MOCK MODE)
GEMMA_API_KEY=

# Model Name / Identifier
# Examples: 'gemma-4', 'gemma-2-9b-it', 'gemma-2-27b-it'
GEMMA_MODEL=gemma-4

# Inference Base URL (For OpenAI-compatible providers or local Ollama / vLLM servers)
# Examples: 'https://api.together.xyz/v1', 'https://api.groq.com/openai/v1', 'http://localhost:11434/v1'
GEMMA_BASE_URL=https://api.openai.com/v1

# Enable raw model response logging (true/false)
DEBUG=false
